NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_IN_PRODUCTION
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM="Eveng Catering Services <no-reply@evengcatering.com>"
ADMIN_EMAIL=admin@example.com
COMPANY_NAME=Eveng Catering
COMPANY_EMAIL=inquiries@evengcatering.com
COMPANY_PHONE=+1 (800) 555-CATER
COMPANY_ADDRESS=90210 Gourmet Row, Suite A, Beverly Hills, CA 90210
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads
